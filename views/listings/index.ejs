<% layout("/layouts/boilerplate") %>

    <div class="tripnest-listings-page container py-4 py-lg-5">
        <div id="filters" class="tripnest-filter-bar">
            <div class="filter tripnest-category active">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountain</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-snowman"></i></div>
                <p>Arctic</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-person-hiking"></i></div>
                <p>Hiking</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Frams</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-igloo"></i></div>
                <p>Dome</p>
            </div>
            <div class="filter tripnest-category">
                <div><i class="fa-solid fa-ship"></i></div>
                <p>Boats</p>
            </div>

            <div class="tax-toggle tripnest-tax-toggle">
                <div class="form-check form-switch d-flex align-items-center gap-2 mb-0">
                    <input class="form-check-input tripnest-toggle-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label tripnest-toggle-label" for="switchCheckDefault">Display total after taxes</label>
                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mt-1">
            <% for( listing of allListing) { %>
                <div class="col">
                    <a href="/listings/<%= listing._id %>" class="listing-link tripnest-listing-link">
                        <div class="card listing-card tripnest-card h-100">
                            <div class="position-relative overflow-hidden">
                                <div class="card-img-overlay"></div>
                                <img src="<%= listing.image.url %>" class="card-img-top tripnest-card-image" alt="listing_img">
                                <div class="tripnest-price-badge">₹<%= listing.price?.toLocaleString("en-IN") %> / Night</div>
                            </div>
                            <div class="card-body tripnest-card-body">
                                <h5 class="tripnest-card-title"><%= listing.title %></h5>
                                <p class="tripnest-card-description"><%= listing.description %></p>
                                <div class="tripnest-location-wrap">
                                    <span class="tripnest-location-icon"><i class="fa-solid fa-location-dot"></i></span>
                                    <div class="tripnest-location-text">
                                        <div class="tripnest-location"><%= listing.location %></div>
                                        <% if (listing.country) { %>
                                            <div class="tripnest-country"><%= listing.country %></div>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="tripnest-tax-row">
                                    <span class="tax-info">+18% GST</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (info of taxInfo) {
                if (info.style.display != "inline") {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
            console.log(taxInfo)
        })
    </script>