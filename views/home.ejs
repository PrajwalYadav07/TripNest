<% layout("layouts/boilerplate") %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/webfonts/fa-solid-900.woff2" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --tn-ink: #10201d;
    --tn-ink-soft: #3d4f4b;
    --tn-muted: #7a8a86;
    --tn-teal: #0f766e;
    --tn-teal-dark: #0b5a53;
    --tn-sand: #f4efe7;
    --tn-cream: #faf7f1;
    --tn-white: #ffffff;
    --tn-line: rgba(16, 32, 29, 0.1);
  }

  html { scroll-behavior: smooth; }

  body {
    overflow-x: hidden;
    background: var(--tn-cream);
    color: var(--tn-ink);
  }

  .tn-home {
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .tn-serif {
    font-family: "Fraunces", Georgia, serif !important;
  }

  /* ---------- Hero ---------- */

  .tn-hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    isolation: isolate;
    background:
      linear-gradient(180deg, rgba(16, 32, 29, 0.15) 0%, rgba(16, 32, 29, 0.05) 40%, rgba(16, 32, 29, 0.78) 100%),
      url("https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=2000&q=85") center/cover no-repeat;
  }

  .tn-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 0 7.5rem;
  }

  .tn-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .tn-eyebrow::before {
    content: "";
    width: 2.4rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.6);
  }

  .tn-hero h1 {
    max-width: 15ch;
    margin: 0 0 1.4rem;
    color: var(--tn-white);
    font-size: clamp(2.9rem, 6.5vw, 5.4rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.015em;
  }

  .tn-hero h1 em {
    font-style: italic;
    font-weight: 400;
  }

  .tn-hero-copy {
    max-width: 34rem;
    margin: 0 0 2.4rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .tn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 0.55rem 0.55rem 1.7rem;
    border-radius: 999px;
    background: var(--tn-white);
    color: var(--tn-ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .tn-cta:hover {
    color: var(--tn-ink);
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
  }

  .tn-cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--tn-teal);
    color: var(--tn-white);
    font-size: 0.85rem;
    transition: background-color 0.25s ease;
  }

  .tn-cta:hover .tn-cta-icon {
    background: var(--tn-teal-dark);
  }

  /* ---------- Stats strip ---------- */

  .tn-stats {
    position: relative;
    z-index: 2;
    margin-top: -3.4rem;
  }

  .tn-stats-panel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: 20px;
    background: var(--tn-white);
    box-shadow: 0 24px 60px rgba(16, 32, 29, 0.14);
    overflow: hidden;
  }

  .tn-stat {
    padding: 1.7rem 2rem;
    text-align: center;
  }

  .tn-stat + .tn-stat {
    border-left: 1px solid var(--tn-line);
  }

  .tn-stat-number {
    display: block;
    color: var(--tn-teal);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .tn-stat-label {
    display: block;
    margin-top: 0.35rem;
    color: var(--tn-muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- Features ---------- */

  .tn-features {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 6.5rem 0 6rem;
    background: var(--tn-cream);
  }

  .tn-section-head {
    max-width: 40rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .tn-section-eyebrow {
    display: block;
    margin-bottom: 0.9rem;
    color: var(--tn-teal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .tn-section-title {
    margin: 0 0 1rem;
    color: var(--tn-ink);
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .tn-section-copy {
    margin: 0;
    color: var(--tn-muted);
    line-height: 1.75;
  }

  .tn-feature {
    height: 100%;
    padding: 2.2rem 2rem;
    border: 1px solid var(--tn-line);
    border-radius: 22px;
    background: var(--tn-white);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .tn-feature:hover {
    transform: translateY(-5px);
    border-color: rgba(15, 118, 110, 0.25);
    box-shadow: 0 20px 44px rgba(16, 32, 29, 0.1);
  }

  .tn-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 16px;
    background: var(--tn-sand);
    color: var(--tn-teal);
    font-size: 1.15rem;
  }

  .tn-feature h3 {
    margin: 1.3rem 0 0.6rem;
    color: var(--tn-ink);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .tn-feature p {
    margin: 0;
    color: var(--tn-muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  /* ---------- Closing CTA band ---------- */

  .tn-band {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    position: relative;
    padding: 5.5rem 0;
    isolation: isolate;
    text-align: center;
    background:
      linear-gradient(rgba(11, 90, 83, 0.88), rgba(11, 90, 83, 0.88)),
      url("https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=2000&q=80") center/cover no-repeat fixed;
  }

  .tn-band h2 {
    max-width: 22ch;
    margin: 0 auto 1rem;
    color: var(--tn-white);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .tn-band p {
    max-width: 32rem;
    margin: 0 auto 2.2rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.7;
  }

  .tn-band .tn-cta {
    padding-left: 1.7rem;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 991.98px) {
    .tn-hero { min-height: 84vh; }
    .tn-hero-inner { padding-bottom: 8.5rem; }
  }

  @media (max-width: 767.98px) {
    .tn-hero {
      min-height: 86vh;
      background-position: 62% center;
    }

    .tn-hero-inner { padding-bottom: 11rem; }
    .tn-hero-copy { font-size: 0.96rem; }

    .tn-stats { margin-top: -6.5rem; }

    .tn-stats-panel {
      grid-template-columns: 1fr;
      border-radius: 18px;
    }

    .tn-stat { padding: 1.2rem 1.4rem; }

    .tn-stat + .tn-stat {
      border-left: none;
      border-top: 1px solid var(--tn-line);
    }

    .tn-features { padding: 4.5rem 0 4rem; }
    .tn-band { background-attachment: scroll; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .tn-cta, .tn-feature { transition: none; }
  }
</style>

<main class="tn-home">
  <!-- Hero -->
  <section class="tn-hero">
    <div class="container tn-hero-inner">
      <span class="tn-eyebrow">Stays worth remembering</span>
      <h1 class="tn-serif">Find the place your next story <em>begins</em></h1>
      <p class="tn-hero-copy">
        TripNest curates beautiful homes, hideaways, and retreats around the world —
        so every journey starts somewhere extraordinary.
      </p>
      <a href="/listings" class="tn-cta">
        Explore Listings
        <span class="tn-cta-icon"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
      </a>
    </div>
  </section>

  <!-- Stats strip -->
  <div class="container tn-stats" aria-label="TripNest at a glance">
    <div class="tn-stats-panel">
      <div class="tn-stat">
        <span class="tn-stat-number">120+</span>
        <span class="tn-stat-label">Destinations</span>
      </div>
      <div class="tn-stat">
        <span class="tn-stat-number">1,400+</span>
        <span class="tn-stat-label">Unique Stays</span>
      </div>
      <div class="tn-stat">
        <span class="tn-stat-number">4.9<i class="fa-solid fa-star ms-1" style="font-size:1.1rem;" aria-hidden="true"></i></span>
        <span class="tn-stat-label">Guest Rating</span>
      </div>
    </div>
  </div>

  <!-- Features -->
  <section class="tn-features">
    <div class="container">
      <div class="tn-section-head">
        <span class="tn-section-eyebrow">Why TripNest</span>
        <h2 class="tn-section-title tn-serif">Travel made beautifully simple</h2>
        <p class="tn-section-copy">
          Everything you need to find a stay that feels right — nothing you don't.
        </p>
      </div>

      <div class="row g-4">
        <div class="col-lg-4 col-md-6 col-12">
          <article class="tn-feature">
            <span class="tn-feature-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
            <h3>Beautiful Destinations</h3>
            <p>Handpicked places across the globe, from quiet coastlines to vibrant city corners.</p>
          </article>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <article class="tn-feature">
            <span class="tn-feature-icon"><i class="fa-solid fa-house-chimney" aria-hidden="true"></i></span>
            <h3>Stays With Character</h3>
            <p>Homes, cabins, and retreats chosen for comfort, charm, and a sense of place.</p>
          </article>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
          <article class="tn-feature">
            <span class="tn-feature-icon"><i class="fa-regular fa-compass" aria-hidden="true"></i></span>
            <h3>Effortless Exploration</h3>
            <p>Browse listings, compare stays, and find your next destination in minutes.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA band -->
  <section class="tn-band">
    <div class="container">
      <h2 class="tn-serif">Your next escape is already waiting</h2>
      <p>Start browsing TripNest listings and turn “someday” into a booking.</p>
      <a href="/listings" class="tn-cta">
        Explore Listings
        <span class="tn-cta-icon"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
      </a>
    </div>
  </section>
</main>
